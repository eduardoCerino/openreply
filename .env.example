# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
# New Meta apps no longer offer "API setup with Instagram login". Set
# META_LOGIN_MODE=facebook to connect through Facebook Login instead (the
# Instagram account must be linked to a Facebook Page). Then FACEBOOK_APP_ID
# and FACEBOOK_APP_SECRET are required and the INSTAGRAM_APP_* pair is not.
# META_LOGIN_MODE=facebook
# FACEBOOK_APP_ID=your-facebook-app-id
# Optional: a Facebook Login for Business configuration id, used instead of
# the default permission list.
# FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Shopify blog autopublisher (see docs/blog.md). Set on Vercel AND the worker.
# OPENAI_API_KEY=sk-...
# Dev Dashboard apps only show a client ID and secret; the token is fetched
# with the client credentials grant. SHOPIFY_ADMIN_ACCESS_TOKEN replaces both.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_STORE_DOMAIN=6uijcm-ma.myshopify.com
# SHOPIFY_BLOG_HANDLE=suplementos
# SHOP_PUBLIC_URL=https://peachperfect.com.mx
# BLOG_AUTHOR=Equipo editorial
# Daily publishing runs in the worker only when this is true.
# BLOG_AUTOPUBLISH_ENABLED=false
# BLOG_DAILY_CRON=0 9 * * *
# BLOG_TIMEZONE=America/Mexico_City
# OPENAI_MODEL=gpt-6.1-terra
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Video generator clips (docs/videos.md): Pruna P-Video, always draft 720p.
# Set on Vercel AND the worker.
# PRUNA_API_KEY=
